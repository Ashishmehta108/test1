# The first admin account. Created automatically the first time the app starts
# and there are no users yet. Change the password after your first login.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin

# Neon Postgres connection string. Leave empty to use a local database
# stored in ./.data (good for trying it out on your computer).
DATABASE_URL=

# The public web address of the tracker, without a trailing slash.
# Leave empty to use whatever address the browser is on.
# Example: https://track.yourcompany.com
TRACK_BASE_URL=
